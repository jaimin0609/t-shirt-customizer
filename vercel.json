{
    "framework": "vite",
    "buildCommand": "cd Frontend && npm install --legacy-peer-deps && sh scripts/deployment/frontend-vercel-build.sh",
    "outputDirectory": "Frontend/dist",
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/api/(.*)",
            "dest": "https://t-shirt-customizer-backend.onrender.com/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "build": {
        "env": {
            "NODE_OPTIONS": "--experimental-vm-modules --no-warnings --max-old-space-size=4096"
        }
    },
    "nodeVersion": "18.x"
}