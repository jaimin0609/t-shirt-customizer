{
    "version": 2,
    "buildCommand": "node scripts/static-build.js",
    "outputDirectory": "Frontend/dist",
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/api/(.*)",
            "dest": "https://t-shirt-customizer-backend.onrender.com/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "build": {
        "env": {
            "NODE_OPTIONS": "--max-old-space-size=4096"
        }
    },
    "nodeVersion": "18.x"
}