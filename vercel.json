{
    "framework": "vite",
    "buildCommand": "cd Frontend && npm install vite@5.4.14 @vitejs/plugin-react postcss tailwindcss autoprefixer --save-dev --force --legacy-peer-deps && sh scripts/deployment/frontend-vercel-build.sh",
    "outputDirectory": "Frontend/dist",
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/api/(.*)",
            "dest": "https://t-shirt-customizer-backend.onrender.com/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "env": {
        "VITE_FORCE_VERSION": "5.4.14",
        "NODE_ENV": "production"
    }
}