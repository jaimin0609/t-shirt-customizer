{
    "name": "t-shirt-customizer",
    "version": "1.0.0",
    "scripts": {
        "start:backend": "cd Backend && npm start",
        "start:frontend": "cd Frontend && npm run dev",
        "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
        "build:frontend": "cd Frontend && npm run build",
        "build:install": "npm install && (cd Backend && npm install --legacy-peer-deps) && (cd Frontend && npm install)",
        "start:prod": "cd Backend && NODE_ENV=production npm start",
        "deploy": "npm run build:frontend && npm run start:prod",
        "setup": "cd Backend && npm install --legacy-peer-deps && cd ../Frontend && npm install",
        "security-check": "node scripts/security-check.js",
        "pre-deploy": "npm run security-check && npm audit",
        "dependency-check": "node scripts/check-dependencies.js",
        "dependency-check:fix": "node scripts/check-dependencies.js --fix",
        "dependency-check:security": "node scripts/check-dependencies.js --security",
        "security-update": "node scripts/security-update.js",
        "security-update:frontend": "node scripts/security-update.js --frontend",
        "security-update:backend": "node scripts/security-update.js --backend",
        "build": "cd Frontend && npm install && npm run build && cp -r public/* dist/ && cp dist/index.html dist/404.html"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.21",
        "concurrently": "^8.2.2",
        "postcss": "^8.5.3",
        "tailwindcss": "3.4.17",
        "vite": "^6.2.2",
        "vite-plugin-pwa": "^0.19.4"
    },
    "dependencies": {
        "cross-env": "^7.0.3",
        "node-fetch": "^3.3.2"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}