# T-Shirt Customizer Frontend Configuration
# Copy this file to .env for local development

# ===== Environment Settings =====
# Possible values: development, production, test
VITE_ENVIRONMENT=development

# ===== API Configuration =====
# Base URL for API requests
VITE_API_URL=http://localhost:3000
# Timeout for API requests in milliseconds
VITE_API_TIMEOUT=30000
# Number of automatic retries for failed requests
VITE_API_RETRY_COUNT=2
# Fallback API URL
VITE_FALLBACK_API_URL=

# ===== Cloudinary Configuration =====
# Your Cloudinary cloud name
VITE_CLOUDINARY_CLOUD_NAME=dopvs93sl
# Your Cloudinary API key
VITE_CLOUDINARY_API_KEY=638173488943618
# Your Cloudinary upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default
# Cloudinary URL prefix for image URLs
VITE_CLOUDINARY_URL_PREFIX=https://res.cloudinary.com/dopvs93sl

# ===== Authentication Configuration =====
# Refresh token interval in milliseconds (default: 20 minutes)
VITE_AUTH_REFRESH_INTERVAL=1200000
# Inactivity timeout in milliseconds (default: 1 hour)
VITE_AUTH_INACTIVITY_TIMEOUT=3600000

# ===== Feature Flags =====
# Enable analytics tracking (true/false)
VITE_ENABLE_ANALYTICS=false
# Enable error reporting to monitoring services (true/false)
VITE_ENABLE_ERROR_REPORTING=false
# Enable AI assistant features (true/false)
VITE_ENABLE_AI_ASSISTANT=true
# Enable error tracking (true/false)
VITE_ENABLE_ERROR_TRACKING=false
# Enable performance monitoring (true/false)
VITE_ENABLE_PERFORMANCE_MONITORING=false
# Enable user behavior tracking (true/false)
VITE_ENABLE_USER_BEHAVIOR_TRACKING=false

# ===== UI Configuration =====
# Animation speed in milliseconds
VITE_ANIMATION_SPEED=300
# Toast notification duration in milliseconds
VITE_TOAST_DURATION=5000
# Default items per page in paginated lists
VITE_DEFAULT_PAGE_SIZE=10

# Google Maps API Key (for address autocomplete)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics Configuration
VITE_ANALYTICS_PROVIDER=google
VITE_ANALYTICS_TRACKING_ID=
VITE_ANALYTICS_SAMPLE_RATE=1.0
VITE_ANALYTICS_DEBUG=false

# Error Tracking Configuration
VITE_ERROR_TRACKING_PROVIDER=sentry
VITE_ERROR_TRACKING_DSN=
VITE_ERROR_TRACKING_ENVIRONMENT=development
VITE_ERROR_TRACKING_SAMPLE_RATE=1.0
VITE_ERROR_TRACKING_MAX_ERRORS=100

# Performance Monitoring Configuration
VITE_PERFORMANCE_ENABLE_RESOURCE_TIMING=true
VITE_PERFORMANCE_ENABLE_NAVIGATION_TIMING=true
VITE_PERFORMANCE_ENABLE_USER_TIMING=true
VITE_PERFORMANCE_SAMPLE_RATE=1.0
VITE_PERFORMANCE_MAX_ENTRIES=1000

# User Behavior Tracking Configuration
VITE_USER_BEHAVIOR_ENABLE_PAGE_VIEWS=true
VITE_USER_BEHAVIOR_ENABLE_INTERACTIONS=true
VITE_USER_BEHAVIOR_ENABLE_SESSION_TRACKING=true
VITE_USER_BEHAVIOR_SAMPLE_RATE=1.0
VITE_USER_BEHAVIOR_MAX_INTERACTIONS=1000

# Development Settings
VITE_DEV_LOG_ANALYTICS=true
VITE_DEV_LOG_ERRORS=true
VITE_DEV_LOG_PERFORMANCE=true
VITE_DEV_LOG_USER_BEHAVIOR=true

# Other configurations can be added here
# VITE_SOME_OTHER_VAR=some_value 

# Other environment variables
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key 