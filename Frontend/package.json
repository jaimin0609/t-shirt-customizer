{
  "name": "t-shirt-customizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html && cp -r public/* dist/",
    "build:vercel": "sh scripts/deployment/frontend-vercel-build.sh",
    "build:github": "sh scripts/deployment/frontend-github-pages-build.sh",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "node server.js",
    "analyze": "cross-env ANALYZE=true npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.2",
    "@react-three/drei": "^9.90.0",
    "@react-three/fiber": "^8.15.12",
    "@stripe/react-stripe-js": "^3.1.0",
    "@stripe/stripe-js": "^5.7.0",
    "axios": "^1.6.7",
    "babylonjs": "^7.0.0",
    "classnames": "^2.5.1",
    "fabric": "^5.3.0",
    "framer-motion": "^10.16.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.20.1",
    "react-toastify": "^9.1.3",
    "three": "^0.159.0",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "vite": "6.2.2",
    "vite-plugin-pwa": "^0.17.4"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "glob-parent": "^5.1.2",
    "sourcemap-codec": "@jridgewell/sourcemap-codec@1.4.15",
    "three-mesh-bvh": "^0.8.0",
    "npmlog": "@npmcli/lib-log@1.0.1",
    "gauge": "gauge4@4.0.4",
    "are-we-there-yet": "which-pm@2.0.0"
  }
